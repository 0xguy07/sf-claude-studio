{
  "name": "sf-claude-studio",
  "version": "0.5.0",
  "description": "A Claude Code harness for Salesforce delivery work — agents, skills, hooks, and path-scoped rules in one drop-in folder.",
  "keywords": [
    "salesforce",
    "claude-code",
    "claude",
    "anthropic",
    "ai",
    "apex",
    "lwc",
    "sfdx",
    "developer-tools"
  ],
  "homepage": "https://github.com/0xguy07/sf-claude-studio",
  "bugs": "https://github.com/0xguy07/sf-claude-studio/issues",
  "license": "MIT",
  "author": "Guy Friley <0xguy07@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xguy07/sf-claude-studio.git",
    "directory": "cli"
  },
  "type": "module",
  "bin": {
    "sfcs": "./src/bin.js"
  },
  "files": [
    "src/",
    "templates/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build:templates": "node scripts/sync-templates.js",
    "prepublishOnly": "npm run build:templates",
    "test": "node --test src/**/*.test.js",
    "doctor": "node ./src/bin.js doctor",
    "init:dryrun": "node ./src/bin.js init --help"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.0.0",
    "commander": "^12.0.0",
    "kolorist": "^1.8.0"
  }
}
